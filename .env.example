# ==============================================================================
# PatchGraph configuration (.env.example)
# Copy to .env for local runs. Docker Compose reads the same variable names.
# ==============================================================================

# Storage: PatchGraph uses a single SQLite file (the schema is translated from backend/migrations/001_core.sql).
# Defaults to data/patchgraph.db; the container uses /data/patchgraph.db on a volume.
PATCHGRAPH_SQLITE_PATH=

# Server binding
HOST=127.0.0.1
PORT=5000

# CORS allowed origins (comma separated, no wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Frontend API gateway URL (consumed by Vite during build/dev)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Authentication
# Required when PATCHGRAPH_ENV=production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PATCHGRAPH_AUTH_SIGNING_KEY=
# Local demo only: accept X-User-Id / X-Project-Id headers without a bearer token. Ignored in production.
PATCHGRAPH_ALLOW_DEMO_IDENTITY=true

# Threat intelligence connector settings (optional; the offline demo uses cached seeds)
NVD_API_KEY=
FIRST_EPSS_ENDPOINT=https://api.first.org/data/v1/epss
CISA_KEV_ENDPOINT=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
OSV_API_ENDPOINT=https://api.osv.dev/v1/query

# Serve interactive API docs at /docs, /redoc and /openapi.json (off by default)
PATCHGRAPH_ENABLE_DOCS=false

# Operational mode: development | production
PATCHGRAPH_OFFLINE_DEMO=true
PATCHGRAPH_ENV=development
LOG_LEVEL=info
