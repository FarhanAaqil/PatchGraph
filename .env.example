# ==============================================================================
# PatchGraph Platform Configuration (.env.example)
# ==============================================================================

# Core Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://patchgraph:patchgraph_local_dev_only@localhost:5432/patchgraph
POSTGRES_USER=patchgraph
POSTGRES_PASSWORD=patchgraph_local_dev_only
POSTGRES_DB=patchgraph

# Caching & Queue Broker (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Server Binding
HOST=127.0.0.1
PORT=5000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Frontend API Gateway URL (Consumed by Vite during build/dev)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Threat Intelligence Connector API Keys (Optional - fallbacks to cached deterministic seeds)
NVD_API_KEY=
FIRST_EPSS_ENDPOINT=https://api.first.org/data/v1/epss
CISA_KEV_ENDPOINT=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
OSV_API_ENDPOINT=https://api.osv.dev/v1/query

# Operational Mode
PATCHGRAPH_OFFLINE_DEMO=true
ENVIRONMENT=development
LOG_LEVEL=info

